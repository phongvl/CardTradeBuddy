@page
@model CardTradeBuddy.Pages.Account.ForgotPasswordModel
@{
    Layout = "_LayoutHome";
    ViewData["Title"] = T["ForgotTitle"].Value;
}

<main class="home-page">
    <partial name="_Hero" />

    <section class="login-sheet" aria-labelledby="page-heading">
        <span class="sheet-handle" aria-hidden="true"></span>
        <h2 id="page-heading">@T["ForgotTitle"]</h2>

        @if (Model.Sent)
        {
            <p class="message notice" role="status">@T["ForgotSent"]</p>
            <a class="btn btn-primary" asp-page="/Account/Login">@T["BackToLogin"]</a>
        }
        else
        {
            <p class="intro">@T["ForgotIntro"]</p>
            @if (Model.Error is not null)
            {
                <p class="message error" role="alert">@Model.Error</p>
            }

            <form method="post" novalidate>
                <div class="field">
                    <label for="email">@T["Email"]</label>
                    <input id="email" name="Email" type="email" inputmode="email" autocomplete="email" placeholder="@T["EmailPlaceholder"]" value="@Model.Email" />
                </div>

                <partial name="_FormGuard" />
                <button type="submit" class="btn btn-primary">@T["ForgotSend"]</button>
                <a class="btn btn-secondary" asp-page="/Account/Login">@T["BackToLogin"]</a>
            </form>
        }
    </section>
</main>
