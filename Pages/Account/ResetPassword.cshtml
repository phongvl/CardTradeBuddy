@page
@model CardTradeBuddy.Pages.Account.ResetPasswordModel
@using CardTradeBuddy.Services
@{
    Layout = "_LayoutHome";
    ViewData["Title"] = T["ResetTitle"].Value;
}

<main class="home-page">
    <partial name="_Hero" />

    <section class="login-sheet" aria-labelledby="page-heading">
        <span class="sheet-handle" aria-hidden="true"></span>
        <h2 id="page-heading">@T["ResetTitle"]</h2>

        @if (Model.Error is not null)
        {
            <p class="message error" role="alert">@Model.Error</p>
        }

        @if (Model.TokenProblem)
        {
            <a class="btn btn-primary" asp-page="/Account/ForgotPassword">@T["RequestNewLink"]</a>
        }
        else
        {
            <form method="post" novalidate>
                <input type="hidden" name="Token" value="@Model.Token" />

                <partial name="_PasswordField" model="@(new PasswordFieldModel("password", "NewPassword", T["NewPassword"].Value, "new-password", Hint: T["PasswordHint", PasswordRules.MinLength].Value))" />
                <partial name="_PasswordField" model="@(new PasswordFieldModel("confirm", "ConfirmPassword", T["ConfirmPassword"].Value, "new-password"))" />

                <button type="submit" class="btn btn-primary">@T["ResetSave"]</button>
            </form>
        }
    </section>
</main>
