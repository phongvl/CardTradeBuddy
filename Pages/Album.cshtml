@page
@model CardTradeBuddy.Pages.AlbumModel
@using System.Globalization
@using CardTradeBuddy.Services
@{
    Layout = "_LayoutHome";
    ViewData["Title"] = Model.Title;
}

<main class="check-page album-page">
    <header class="check-header">
        <partial name="_LanguageSwitch" />
        <h1 class="check-title">@Model.Title</h1>
        <a class="check-back" asp-page="/Start" aria-label="@T["BackToStart"]">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 5 L7.5 12 L14.5 19" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
    </header>

    <section class="album-panel" aria-label="@Model.Title">
        @if (Model.TotalCards == 0)
        {
            <div class="album-empty">
                <p><strong>@T["AlbumEmpty"]</strong><br />@T["AlbumEmptyHint"]</p>
                <a class="btn btn-primary" asp-page="/Check">@T["StartCheckTitle"]</a>
            </div>
        }
        else
        {
            <div class="album-toolbar">
                <p class="album-count">@(Model.TotalCards == 1 ? T["AlbumCountOne"].Value : T["AlbumCountMany", Model.TotalCards].Value)</p>
                <button type="button" class="album-update-all" id="update-all" data-total="@Model.TotalCards"
                        data-progress="@T["AlbumUpdating"]" data-done="@T["AlbumUpdateDone"]" data-summary="@T["AlbumUpdateSummary"]" data-error="@T["DetailFailed"]">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    <span>@T["AlbumUpdateAll"]</span>
                </button>
            </div>
            <div id="update-status" class="album-update-status" role="status" hidden>
                <span id="update-text"></span>
                <span class="update-bar" aria-hidden="true"><span id="update-fill"></span></span>
            </div>

            <partial name="_FinishSprite" />

            @* Each card is a button: a click opens its popup with everything saved about it. The small icon in the corner is the version of the card. *@
            <ul class="album-grid">
                @foreach (var card in Model.Cards)
                {
                    <li class="album-card">
                      <button type="button" class="album-card-button" data-card="@card.Id" aria-label="@card.Name" aria-haspopup="dialog">
                        <span class="album-pic">
                            @if (AlbumModel.ThumbnailUrl(card.ImageUrl) is { } thumb)
                            {
                                <img class="album-thumb" src="@thumb" alt="" width="63" height="88" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <span class="album-thumb no-image" aria-hidden="true">?</span>
                            }
                            @if (card.Finish is CardFinish.Normal or CardFinish.Holofoil or CardFinish.ReverseHolofoil)
                            {
                                var finishName = Model.FinishName(card.Finish);
                                <span class="album-finish" role="img" aria-label="@finishName" title="@finishName">
                                    <svg viewBox="0 0 30 42" aria-hidden="true"><use href="#finish-@card.Finish.ToString().ToLowerInvariant()" /></svg>
                                </span>
                            }
                        </span>
                        <span class="album-name">@card.Name</span>
                        @if (card.EstimatedPriceEur is { } price)
                        {
                            <span class="album-price" title="@T["AlbumPriceChecked", card.PricesCheckedAt.ToLocalTime().ToString("d", CultureInfo.CurrentCulture)]">@Model.Money(price)</span>
                        }
                        else
                        {
                            <span class="album-price none" aria-label="@T["AlbumNoPrice"]" title="@T["AlbumNoPrice"]">&ndash;</span>
                        }
                      </button>
                    </li>
                }
            </ul>

            @if (Model.TotalPages > 1)
            {
                <nav class="album-pages" aria-label="@T["AlbumPageLabel"]">
                    @if (Model.PageNumber > 1)
                    {
                        <a asp-page="/Album" asp-route-p="@(Model.PageNumber - 1)" asp-route-album="@Model.AlbumId" rel="prev">@T["AlbumPrev"]</a>
                    }
                    else
                    {
                        <span class="is-disabled" aria-disabled="true">@T["AlbumPrev"]</span>
                    }

                    @foreach (var n in Model.PageLinks)
                    {
                        if (n is null)
                        {
                            <span class="gap" aria-hidden="true">&hellip;</span>
                        }
                        else if (n == Model.PageNumber)
                        {
                            <span class="is-current" aria-current="page" aria-label="@T["AlbumPageN", n]">@n</span>
                        }
                        else
                        {
                            <a asp-page="/Album" asp-route-p="@n" asp-route-album="@Model.AlbumId" aria-label="@T["AlbumPageN", n]">@n</a>
                        }
                    }

                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a asp-page="/Album" asp-route-p="@(Model.PageNumber + 1)" asp-route-album="@Model.AlbumId" rel="next">@T["AlbumNext"]</a>
                    }
                    else
                    {
                        <span class="is-disabled" aria-disabled="true">@T["AlbumNext"]</span>
                    }
                </nav>
            }

            @* The value of the whole album (all pages), at the bottom right. *@
            <div class="album-total">
                <span class="album-total-label">@T["AlbumTotal"]</span>
                <strong class="album-total-amount">@Model.Money(Model.TotalValueEur)</strong>
                @if (Model.CardsWithoutPrice > 0)
                {
                    <span class="album-total-note">@(Model.CardsWithoutPrice == 1 ? T["AlbumTotalMissingOne"].Value : T["AlbumTotalMissingMany", Model.CardsWithoutPrice].Value)</span>
                }
            </div>
        }
    </section>

    @* The card popup: filled with /Album?handler=Card when a thumbnail is clicked. The hidden form only carries the anti-forgery token for the update buttons. *@
    <dialog id="card-dialog" class="card-dialog" aria-labelledby="card-dialog-title">
        <button type="button" class="card-dialog-close" data-close-card aria-label="@T["DetailClose"]" title="@T["DetailClose"]">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6 L18 18 M18 6 L6 18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>
        </button>
        <div id="card-dialog-body" class="card-dialog-body"></div>
    </dialog>
    <form method="post" id="album-form" class="visually-hidden" data-card-url="@Url.Page("/Album", "Card")" data-refresh-card-url="@Url.Page("/Album", "RefreshCard")" data-refresh-all-url="@Url.Page("/Album", "RefreshAll")" data-album="@Model.AlbumId"
          data-loading="@T["DetailLoading"]" data-updating="@T["DetailUpdating"]" data-failed="@T["DetailFailed"]"></form>
</main>

<script src="~/js/album.js" asp-append-version="true" defer></script>
