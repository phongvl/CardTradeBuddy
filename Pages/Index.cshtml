@page
@model IndexModel
@using System.Globalization
@{
    ViewData["Title"] = Localizer["Title"].Value;
    ViewData["BodyClass"] = "home";
    var language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}

@section Head {
    <meta name="theme-color" content="#FFF3CC" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<main class="home-page">
    <header class="hero">
        @* Each flag posts its language code; the handler stores it in the language cookie and reloads the page. *@
        <form method="post" asp-page-handler="Language" class="lang-switch" aria-label="@Localizer["LanguageNavLabel"]">
            <button type="submit" name="culture" value="en" class="lang @(language == "en" ? "is-active" : "")" lang="en" aria-pressed="@(language == "en" ? "true" : "false")" aria-label="English">
                <svg viewBox="0 0 60 60" aria-hidden="true">
                    <clipPath id="clip-en"><circle cx="30" cy="30" r="30" /></clipPath>
                    <g clip-path="url(#clip-en)">
                        <rect width="60" height="60" fill="#012169" />
                        <path d="M0 0 L60 60 M60 0 L0 60" stroke="#FFFFFF" stroke-width="12" />
                        <path d="M0 0 L60 60 M60 0 L0 60" stroke="#C8102E" stroke-width="4" />
                        <path d="M30 0 V60 M0 30 H60" stroke="#FFFFFF" stroke-width="20" />
                        <path d="M30 0 V60 M0 30 H60" stroke="#C8102E" stroke-width="12" />
                    </g>
                </svg>
            </button>
            <button type="submit" name="culture" value="da" class="lang @(language == "da" ? "is-active" : "")" lang="da" aria-pressed="@(language == "da" ? "true" : "false")" aria-label="Dansk">
                <svg viewBox="0 0 60 60" aria-hidden="true">
                    <clipPath id="clip-da"><circle cx="30" cy="30" r="30" /></clipPath>
                    <g clip-path="url(#clip-da)">
                        <rect width="60" height="60" fill="#C8102E" />
                        <path d="M22 0 V60 M0 30 H60" stroke="#FFFFFF" stroke-width="8" />
                    </g>
                </svg>
            </button>
        </form>

        <h1 class="hero-title">CardTradeBuddy</h1>
        <p class="hero-tagline">@Localizer["Tagline"]</p>

        <svg class="hero-art" viewBox="-14 100 368 282" role="img" aria-label="@Localizer["HeroArtLabel"]">
            <defs>
                <g id="card">
                    <rect x="-22" y="-31" width="44" height="62" rx="6" fill="#FACC15" stroke="#B7791F" stroke-width="2.5" />
                    <rect x="-15" y="-24" width="30" height="28" rx="3" fill="currentColor" />
                    <polygon transform="translate(0,-10) scale(0.38)" points="0,-22 6,-7 22,-7 9,3 14,19 0,10 -14,19 -9,3 -22,-7 -6,-7" fill="#FFFFFF" />
                    <rect x="-15" y="10" width="30" height="4" rx="2" fill="#FFFFFF" />
                    <rect x="-15" y="19" width="20" height="4" rx="2" fill="#FFFFFF" />
                </g>
                <g id="spark"><path d="M0 -12 L3 -3 L12 0 L3 3 L0 12 L-3 3 L-12 0 L-3 -3 Z" /></g>
            </defs>

            <circle cx="170" cy="262" r="132" fill="#FFF3D6" />

            <g fill="#F59E0B">
                <use href="#spark" transform="translate(34,150) scale(1.2)" />
                <use href="#spark" transform="translate(306,122) scale(1.5)" />
                <use href="#spark" transform="translate(120,132) scale(0.6)" />
                <use href="#spark" transform="translate(316,176) scale(0.7)" />
                <use href="#spark" transform="translate(18,196) scale(0.6)" />
            </g>

            <use href="#card" transform="translate(170,150)" style="color:#EF4444" />
            <use href="#card" transform="translate(64,186) rotate(-20)" style="color:#06B6D4" />
            <use href="#card" transform="translate(278,186) rotate(20)" style="color:#F59E0B" />

            <g transform="translate(248,274)">
                <path d="M40 56 L54 8" fill="none" stroke="#10B981" stroke-width="20" stroke-linecap="round" />
                <path d="M54 8 L62 -22" fill="none" stroke="#F2C29B" stroke-width="14" stroke-linecap="round" />
                <circle cx="63" cy="-28" r="10" fill="#F2C29B" />
                <use href="#card" transform="translate(66,-60) rotate(12)" style="color:#8B5CF6" />
                <path d="M-60 104 Q-52 48 -14 44 L14 44 Q52 48 60 104 Z" fill="#10B981" />
                <rect x="-11" y="30" width="22" height="18" fill="#E3A878" />
                <ellipse cx="0" cy="-16" rx="38" ry="34" fill="#E3A12F" />
                <circle cx="-38" cy="-30" r="12" fill="#E3A12F" /><circle cx="38" cy="-30" r="12" fill="#E3A12F" />
                <circle cx="-30" cy="-20" r="4" fill="#EC4899" /><circle cx="30" cy="-20" r="4" fill="#EC4899" />
                <circle cx="-34" cy="4" r="8" fill="#F2C29B" /><circle cx="34" cy="4" r="8" fill="#F2C29B" />
                <ellipse cx="0" cy="0" rx="33" ry="36" fill="#F2C29B" />
                <path d="M-34 -8 Q-14 -34 8 -30 Q26 -26 34 -8 Q8 -22 -34 -8 Z" fill="#E3A12F" />
                <circle cx="-20" cy="14" r="8" fill="#F4A896" /><circle cx="20" cy="14" r="8" fill="#F4A896" />
                <ellipse cx="-13" cy="-2" rx="5" ry="6.5" fill="#1F1F2E" /><ellipse cx="13" cy="-2" rx="5" ry="6.5" fill="#1F1F2E" />
                <circle cx="-11.5" cy="-4.5" r="1.8" fill="#FFFFFF" /><circle cx="14.5" cy="-4.5" r="1.8" fill="#FFFFFF" />
                <path d="M-15 13 Q0 36 15 13 Z" fill="#8B1D2C" />
                <path d="M-13 13.5 L13 13.5 Q8 19 0 19 Q-8 19 -13 13.5 Z" fill="#FFFFFF" />
                <ellipse cx="0" cy="21.5" rx="6" ry="3" fill="#F4727F" />
            </g>

            <g transform="translate(92,274)">
                <path d="M-40 56 L-54 8" fill="none" stroke="#EF4444" stroke-width="20" stroke-linecap="round" />
                <path d="M-54 8 L-62 -22" fill="none" stroke="#F2C29B" stroke-width="14" stroke-linecap="round" />
                <circle cx="-63" cy="-28" r="10" fill="#F2C29B" />
                <use href="#card" transform="translate(-66,-60) rotate(-12)" style="color:#3B82F6" />
                <path d="M-60 104 Q-52 48 -14 44 L14 44 Q52 48 60 104 Z" fill="#EF4444" />
                <rect x="-11" y="30" width="22" height="18" fill="#E3A878" />
                <circle cx="-34" cy="4" r="8" fill="#F2C29B" /><circle cx="34" cy="4" r="8" fill="#F2C29B" />
                <ellipse cx="0" cy="0" rx="33" ry="36" fill="#F2C29B" />
                <path d="M-34 -6 A34 34 0 0 1 34 -6 L34 -3 Q0 -10 -34 -3 Z" fill="#3B82F6" />
                <path d="M4 -8 Q40 -10 46 -1 Q22 1 4 -3 Z" fill="#1D4ED8" />
                <circle cx="0" cy="-40" r="4" fill="#1D4ED8" />
                <circle cx="-20" cy="14" r="8" fill="#F4A896" /><circle cx="20" cy="14" r="8" fill="#F4A896" />
                <ellipse cx="-13" cy="2" rx="5" ry="6.5" fill="#1F1F2E" /><ellipse cx="13" cy="2" rx="5" ry="6.5" fill="#1F1F2E" />
                <circle cx="-11.5" cy="-0.5" r="1.8" fill="#FFFFFF" /><circle cx="14.5" cy="-0.5" r="1.8" fill="#FFFFFF" />
                <path d="M-15 15 Q0 38 15 15 Z" fill="#8B1D2C" />
                <path d="M-13 15.5 L13 15.5 Q8 21 0 21 Q-8 21 -13 15.5 Z" fill="#FFFFFF" />
                <ellipse cx="0" cy="23.5" rx="6" ry="3" fill="#F4727F" />
            </g>

            <g transform="translate(170,314)">
                <path d="M0 -37 L29 -27 L29 6 Q29 29 0 41 Q-29 29 -29 6 L-29 -27 Z" fill="#22C55E" stroke="#FFFFFF" stroke-width="6" stroke-linejoin="round" />
                <path d="M-12 3 L-3 13 L14 -9" fill="none" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
            </g>
        </svg>
    </header>

    @* Design only: the fields can be typed in, but nothing is submitted or checked yet. *@
    <section class="login-sheet" aria-labelledby="login-heading">
        <span class="sheet-handle" aria-hidden="true"></span>
        <h2 id="login-heading">@Localizer["Welcome"]</h2>

        <form action="#" onsubmit="return false" novalidate>
            <div class="field">
                <label for="email">@Localizer["Email"]</label>
                <input id="email" type="email" inputmode="email" autocomplete="email" placeholder="@Localizer["EmailPlaceholder"]" />
            </div>

            <div class="field">
                <label for="password">@Localizer["Password"]</label>
                <div class="password-wrap">
                    <input id="password" type="password" autocomplete="current-password" placeholder="@Localizer["PasswordPlaceholder"]" />
                    <svg class="eye" viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="12" rx="10" ry="6.5" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="12" cy="12" r="2.6" fill="currentColor" /></svg>
                </div>
            </div>

            <div class="options">
                <label class="remember"><input type="checkbox" checked /> <span>@Localizer["RememberMe"]</span></label>
                <a class="forgot" href="#">@Localizer["ForgotPassword"]</a>
            </div>

            <button type="button" class="btn btn-primary">@Localizer["LogIn"]</button>
            <button type="button" class="btn btn-secondary">@Localizer["CreateUser"]</button>
        </form>
    </section>
</main>
