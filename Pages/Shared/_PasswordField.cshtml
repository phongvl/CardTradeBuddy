@model CardTradeBuddy.Pages.PasswordFieldModel

@* A password field with an eye button that shows or hides what was typed (wwwroot/js/password-toggle.js). The button starts hidden
   and only appears when JavaScript runs, so there is never a button that does nothing. *@
<div class="field">
    <label for="@Model.Id">@Model.Label</label>
    <div class="password-wrap">
        <input id="@Model.Id" name="@Model.Name" type="password" autocomplete="@Model.Autocomplete" placeholder="@Model.Placeholder" aria-describedby="@(Model.Hint is null ? null : Model.Id + "-hint")" />
        <button type="button" class="eye-toggle" hidden aria-pressed="false" aria-controls="@Model.Id"
                aria-label="@T["ShowPassword"]" data-show-label="@T["ShowPassword"]" data-hide-label="@T["HidePassword"]">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <ellipse cx="12" cy="12" rx="10" ry="6.5" fill="none" stroke="currentColor" stroke-width="1.8" />
                <circle cx="12" cy="12" r="2.6" fill="currentColor" />
                <path class="eye-slash" d="M4 20L20 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
        </button>
    </div>
    @if (Model.Hint is not null)
    {
        <p id="@(Model.Id + "-hint")" class="hint">@Model.Hint</p>
    }
</div>