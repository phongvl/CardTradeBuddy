@* The "saved cards" icon in the header, only for a logged-in user. Only the icon for now: there is nothing behind it yet, so it is not a
   link or a button. When the page exists, make it an <a asp-page="..."> with the same class. *@
@if (User.Identity?.IsAuthenticated == true)
{
    <span class="saved-icon" role="img" aria-label="@T["SavedCards"]" title="@T["SavedCards"]">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3.8" y="4" width="11" height="15" rx="2" transform="rotate(-10 9.3 11.5)" fill="none" stroke="currentColor" stroke-width="1.8" />
            <rect x="8.4" y="5.6" width="11" height="15" rx="2" fill="#ffffff" stroke="currentColor" stroke-width="1.8" />
            <path d="M12.6 5.6 V12.4 L14.4 10.9 L16.2 12.4 V5.6 Z" fill="currentColor" />
        </svg>
    </span>
}
